{
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "esbuild app/javascript/hotwire_app.js --bundle --sourcemap --format=iife --target=es2020 --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass --no-source-map --load-path=app/assets/stylesheets app/assets/stylesheets/application.sass:app/assets/builds/application.css app/assets/stylesheets/logged_in_only.sass:app/assets/builds/logged_in_only.css app/assets/stylesheets/env_specific.sass:app/assets/builds/env_specific.css",
    "lint": "eslint 'app/javascript/**/*.js' 'app/assets/javascripts/**/*.js'"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@hotwired/stimulus": "~3.2.1",
    "@hotwired/turbo-rails": "~7.2.5",
    "awesome-notifications": "^3.1.3",
    "corejs-typeahead": "^1.3.1",
    "esbuild": "^0.28.2",
    "sass": "^1.105.1",
    "sortablejs": "^1.15.0",
    "stimulus-use": "~0.51.3",
    "tablesort": "^5.3.0"
  },
  "devDependencies": {
    "eslint": "~8.57.1",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "~2.32.0"
  }
}
