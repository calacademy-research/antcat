{
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "esbuild app/javascript/hotwire_app.js --bundle --sourcemap --format=iife --target=es2020 --outdir=app/assets/builds --public-path=/assets",
    "build:css": "yarn build:sass && yarn build:tailwind",
    "build:sass": "sass --no-source-map --load-path=app/assets/stylesheets app/assets/stylesheets/application.sass:app/assets/builds/application.css app/assets/stylesheets/logged_in_only.sass:app/assets/builds/logged_in_only.css app/assets/stylesheets/env_specific.sass:app/assets/builds/env_specific.css",
    "build:tailwind": "tailwindcss -i app/assets/stylesheets/application.tailwind.css -o app/assets/builds/tailwind.css --minify",
    "lint": "eslint 'app/javascript/**/*.js' 'app/assets/javascripts/**/*.js'"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "awesome-notifications": "^3.1.3",
    "corejs-typeahead": "^1.3.4",
    "esbuild": "^0.28.2",
    "sass": "^1.105.1",
    "sortablejs": "^1.15.7",
    "stimulus-use": "^0.53.1",
    "tablesort": "^5.7.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "eslint": "~8.57.1",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-plugin-import": "~2.32.0"
  }
}
