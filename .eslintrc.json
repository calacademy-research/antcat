{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "globals": {
    "AntCat": "readonly"
  },
  "rules": {
    "consistent-return": "off",
    "class-methods-use-this": "off",
    "dot-location": [
      "error",
      "object"
    ],
    "func-names": "off",
    "import/no-unresolved": "off",
    "key-spacing": "off",
    "max-len": "off",
    "no-alert": "off",
    "no-console": "off",
    "no-else-return": "off",
    "no-param-reassign": "off",
    "no-underscore-dangle": "off",
    "no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": true
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "operator-linebreak": "off",
    "quotes": "off",
    "radix": "off",
    "semi": [
      "error",
      "never"
    ],
    "space-before-function-paren": "off"
  },
  "overrides": [
    {
      "files": [
        "app/assets/javascripts/**/*.js"
      ],
      "parserOptions": {
        "sourceType": "script"
      },
      "env": {
        "jquery": true
      },
      "globals": {
        "Bloodhound": "readonly"
      }
    },
    {
      "files": [
        "app/javascript/controllers/application.js",
        "app/javascript/controllers/index.js"
      ],
      "rules": {
        "import/first": "off",
        "import/newline-after-import": "off",
        "import/prefer-default-export": "off"
      }
    }
  ]
}
