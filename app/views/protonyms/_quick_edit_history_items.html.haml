.callout-white.mb-8
  %h5
    Protonym history items
    .float-right
      =link_to 'Add', new_protonym_history_item_path(protonym, **current_page_redirect_back_url), data: { testid: 'add-history-item-button' }, class: 'btn-default'
      =link_to "Reorder", protonym_reorder_history_items_path(protonym), disabled: (protonym.history_items.size < 2), class: "btn-default"

  =render 'history_items/grouped_editor', grouped_items: HistoryPresenter.new(protonym.history_items).grouped_items, mark_types: true
