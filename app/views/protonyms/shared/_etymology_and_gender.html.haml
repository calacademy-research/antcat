-show_agreement_in_gender = taxon.is_a?(SpeciesGroupTaxon)

-if protonym.etymology? || show_agreement_in_gender || protonym.gender_agreement_type? || protonym.spelling_basis?
  .bluebox
    -if protonym.etymology?
      %strong Etymology:
      =render 'protonyms/shared/etymology', protonym: protonym

    -if show_agreement_in_gender
      -if protonym.etymology?
        %hr

      %h6
        Agreement in gender
        =tooltip_icon 'Which genus gender to agree with can currently only be shown on catalog pages (Taxon records)'
      %p
        The spelling of this species-group name
        -if protonym.changeable_name?
          is
          %strong changeable
          and
          %string must agree
        -elsif protonym.unchangeable_name?
          is
          %strong unchangeable.
        -else
          %strong
            %i may or may not
            have to agree

        -unless protonym.unchangeable_name?
          with the gender of
          =succeed ',' do
            =CatalogFormatter.link_to_taxon_with_label(taxon.genus, 'its genus')
          which is
          =succeed '.' do
            %strong=taxon.genus.name.gender || '???'

    -if protonym.gender_agreement_type?
      %p
        Gender agreement type:
        %code=protonym.gender_agreement_type
        -if protonym.part_of_speech_basis?
          %br
          Basis: #{protonym.part_of_speech_basis_label}

    -if protonym.spelling_basis?
      %p
        Accepted spelling, basis: #{protonym.spelling_basis_label}

    -if protonym.interpretation_status?
      %p
        Interpretation:
        %strong=protonym.interpretation_status_label

    -if (grammar_page = protonym.grammar_and_spelling_wiki_page)
      %p
        Grammar and spelling:
        =link_to grammar_page.title, grammar_page

    -if (gender_epithets = protonym.gender_epithets)
      %p
        Spelling by genus gender:
        -gender_epithets.each do |gender, epithet|
          %br
          =gender
          %i=epithet.presence || '?'
        -if taxon.is_a?(SpeciesGroupTaxon) && (expected = protonym.epithet_for_gender(taxon.genus&.name&.gender))
          %br
          -if expected == taxon.name.epithet
            This name agrees with its genus.
          -elsif protonym.spelling_kept_against_agreement?
            Spelling kept (#{protonym.spelling_basis_label || protonym.interpretation_status_label}), not
            %i=expected
          -else
            %strong
              In #{taxon.genus.name.name} it should read
              %i=expected
