-page_title "Finish Signing Up"
-breadcrumb :sign_up

=form_with model: resource, url: complete_user_sign_up_path, method: :post, data: { turbo: false } do |f|
  =render 'shared/errors_for', resource: resource
  =hidden_field_tag :token, @sign_up_token

  .row
    .medium-6.mb-4
      =f.label :email do
        Email (public)
      =f.email_field :email, disabled: true, class: 'w-full'

      .mb-4

      =f.label :name do
        Name (full name, public)
        =tooltip_icon "Please use your real name, or your account may be deactivated."
      =f.text_field :name, class: 'w-full'

  .row.mb-4
    .medium-6
      =f.label :password, "Password (#{@minimum_password_length} characters minimum)"
      =f.password_field :password, autofocus: true, autocomplete: 'new-password', class: 'w-full'

      .mb-4

      =f.label :password_confirmation
      =f.password_field :password_confirmation, autocomplete: 'new-password', class: 'w-full'

  .row
    .medium-6
      =f.button "Finish Signing Up", class: "btn-saves btn-md"
