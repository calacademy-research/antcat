-page_title "Free API Key"
-breadcrumb :api_key
-# The link's token is in the web address: send no referrer to other sites. Not `no-referrer`: the
-# button's POST would then carry `Origin: null`, which Rails rejects (see
-# `ApiKeysController#same_origin_referrer`).
-content_for :meta_tags do
  %meta{content: "same-origin", name: "referrer"}

%p Press the button to see your API key. It is shown only once, so please copy it and keep it somewhere safe.

=form_with url: issue_api_key_path, method: :post, data: { turbo: false } do |f|
  =hidden_field_tag :token, @token
  =f.button "Show my API key", class: "btn-saves btn-md"
