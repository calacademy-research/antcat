-# User link for the revision history table.

-if revision.is_a?(PaperTrail::Version)
  -originator = revision.try(:paper_trail_originator)
-else
  -originator = revision.try(:paper_trail).try(:originator)
-user = User.find_by(id: originator) if originator
-if user
  =user.decorate.user_page_link
-else
  [system/unknown]
