FROM ruby:4.0.7-slim

ENV APP_PATH /app
ENV BUNDLER_VERSION 2.7.2

ARG ANTCAT_UID=1000
ARG ANTCAT_GID=1001
ENV ANTCAT_USER antcat
ENV ANTCAT_GROUP antcat

RUN groupadd --system ${ANTCAT_GROUP} --gid ${ANTCAT_GID}
RUN useradd --uid ${ANTCAT_UID} --system --create-home --no-log-init --gid ${ANTCAT_GROUP} ${ANTCAT_USER}

# Create subdir to fix openjdk ("error creating symbolic link '/usr/share/man/man1/java.1.gz.dpkg-tmp'"):
RUN mkdir -p /usr/share/man/man1

RUN apt-get update -qq && apt-get install -y \
  git \
  curl \
  vim \
  build-essential \
  default-libmysqlclient-dev \
  libyaml-dev \
  default-mysql-client \
  default-jre-headless

# Node.js 26 (LTS from late October 2026), at least 26.12.1 (October 2026 security release; the build fails on an
# older one), for the asset build (esbuild, dart-sass) and as the ExecJS runtime for terser.
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
    && apt-get install -y nodejs \
    && node --version \
    && node -e 'const v = process.versions.node.split(".").map(Number); if (v[0] * 1e6 + v[1] * 1e3 + v[2] < 26012001) { console.error("Node " + process.versions.node + " is older than 26.12.1 (Brotli out-of-bounds write fixed in the October 2026 security release)"); process.exit(1); }'

# TODO: Do not use apt-get.
# Install Chromedriver (for RSpec Capybara specs).
RUN apt-get -y update -qq && apt-get -y upgrade
RUN curl \
  --url https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
  --output /tmp/google-chrome-stable_current_amd64.deb
RUN apt --fix-broken install -y /tmp/google-chrome-stable_current_amd64.deb

RUN gem install bundler --version "$BUNDLER_VERSION"
RUN npm install -g yarn

WORKDIR $APP_PATH
