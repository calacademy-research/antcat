<?xml version="1.0" encoding="UTF-8"?>
<!--
  AntCat Sunspot schema for Solr 10 (converted from the Solr 4 / sunspot_solr 2.2.0 schema).

  Kept the same as Solr 4 so search results match:
  - schema version 1.0 (same query-parsing defaults, e.g. autoGeneratePhraseQueries);
  - the same analyzers for `text` and `antcat_text`;
  - ClassicSimilarity (TF-IDF), the Solr 4 scoring, instead of Solr's newer BM25 default.
  Changed because Solr 10 no longer has them:
  - Trie*/Sortable*/DateField numeric types -> *PointField (docValues for sorting/ranges);
  - LatLonType -> LatLonPointSpatialField; StandardFilterFactory removed (it was a no-op);
  - WordDelimiterFilterFactory -> WordDelimiterGraphFilterFactory (+ FlattenGraph at index time);
  - EdgeNGram `side` attribute removed (front was the only option);
  - defaultSearchField / solrQueryParser moved to the /select handler (df, q.op) in solrconfig.xml.
-->
<schema name="sunspot" version="1.0">
  <types>
    <fieldType name="string" class="solr.StrField" omitNorms="true"/>
    <fieldType name="rand" class="solr.RandomSortField" omitNorms="true"/>

    <fieldType name="pint" class="solr.IntPointField" docValues="true" omitNorms="true"/>
    <fieldType name="plong" class="solr.LongPointField" docValues="true" omitNorms="true"/>
    <fieldType name="pfloat" class="solr.FloatPointField" docValues="true" omitNorms="true"/>
    <fieldType name="pdouble" class="solr.DoublePointField" docValues="true" omitNorms="true"/>
    <fieldType name="pdate" class="solr.DatePointField" docValues="true" omitNorms="true"/>
    <fieldType name="boolean" class="solr.BoolField" omitNorms="true"/>

    <fieldType name="text" class="solr.TextField" omitNorms="false">
      <analyzer type="index">
        <charFilter class="solr.MappingCharFilterFactory" mapping="mapping-ISOLatin1Accent.txt"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.WordDelimiterGraphFilterFactory" catenateWords="1" catenateNumbers="1" preserveOriginal="1" splitOnCaseChange="0" generateWordParts="0"/>
        <filter class="solr.FlattenGraphFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.PorterStemFilterFactory"/>
        <filter class="solr.EdgeNGramFilterFactory" minGramSize="1" maxGramSize="45"/>
      </analyzer>
      <analyzer type="query">
        <charFilter class="solr.MappingCharFilterFactory" mapping="mapping-ISOLatin1Accent.txt"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.WordDelimiterGraphFilterFactory" catenateWords="1" catenateNumbers="1" preserveOriginal="1" splitOnCaseChange="0" generateWordParts="0"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.PorterStemFilterFactory"/>
      </analyzer>
    </fieldType>

    <!-- Added for AntCat (like `text`, but also indexes word parts). -->
    <fieldType name="antcat_text" class="solr.TextField" omitNorms="false">
      <analyzer type="index">
        <charFilter class="solr.MappingCharFilterFactory" mapping="mapping-ISOLatin1Accent.txt"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.WordDelimiterGraphFilterFactory" catenateWords="1" catenateNumbers="1" preserveOriginal="1" splitOnCaseChange="0" generateWordParts="1"/>
        <filter class="solr.FlattenGraphFilterFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.PorterStemFilterFactory"/>
        <filter class="solr.EdgeNGramFilterFactory" minGramSize="1" maxGramSize="45"/>
      </analyzer>
      <analyzer type="query">
        <charFilter class="solr.MappingCharFilterFactory" mapping="mapping-ISOLatin1Accent.txt"/>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.WordDelimiterGraphFilterFactory" catenateWords="1" catenateNumbers="1" preserveOriginal="1" splitOnCaseChange="0" generateWordParts="1"/>
        <filter class="solr.LowerCaseFilterFactory"/>
        <filter class="solr.PorterStemFilterFactory"/>
      </analyzer>
    </fieldType>

    <fieldType name="textSpell" class="solr.TextField" positionIncrementGap="100" omitNorms="true">
      <analyzer>
        <tokenizer class="solr.StandardTokenizerFactory"/>
        <filter class="solr.LowerCaseFilterFactory"/>
      </analyzer>
    </fieldType>

    <fieldType name="location" class="solr.LatLonPointSpatialField" docValues="true"/>
  </types>

  <fields>
    <field name="id" stored="true" type="string" multiValued="false" indexed="true"/>
    <field name="type" stored="false" type="string" multiValued="true" indexed="true"/>
    <field name="class_name" stored="false" type="string" multiValued="false" indexed="true"/>
    <field name="text" stored="false" type="string" multiValued="true" indexed="true"/>
    <field name="antcat_text" stored="false" type="string" multiValued="true" indexed="true"/>
    <field name="lat" stored="true" type="pdouble" multiValued="false" indexed="true"/>
    <field name="lng" stored="true" type="pdouble" multiValued="false" indexed="true"/>
    <field name="textSpell" stored="false" type="textSpell" multiValued="true" indexed="true"/>
    <field name="_version_" type="plong" indexed="false" stored="false" multiValued="false"/>

    <dynamicField name="random_*" stored="false" type="rand" multiValued="false" indexed="true"/>
    <dynamicField name="_local*" stored="false" type="pdouble" multiValued="false" indexed="true"/>
    <dynamicField name="*_text" stored="false" type="text" multiValued="true" indexed="true"/>
    <dynamicField name="*_antcat_text" stored="false" type="antcat_text" multiValued="true" indexed="true"/>
    <dynamicField name="*_texts" stored="true" type="text" multiValued="true" indexed="true"/>
    <dynamicField name="*_textv" stored="false" termVectors="true" type="text" multiValued="true" indexed="true"/>
    <dynamicField name="*_textsv" stored="true" termVectors="true" type="text" multiValued="true" indexed="true"/>
    <dynamicField name="*_b" stored="false" type="boolean" multiValued="false" indexed="true"/>
    <dynamicField name="*_bm" stored="false" type="boolean" multiValued="true" indexed="true"/>
    <dynamicField name="*_bs" stored="true" type="boolean" multiValued="false" indexed="true"/>
    <dynamicField name="*_bms" stored="true" type="boolean" multiValued="true" indexed="true"/>
    <dynamicField name="*_d" stored="false" type="pdate" multiValued="false" indexed="true"/>
    <dynamicField name="*_dm" stored="false" type="pdate" multiValued="true" indexed="true"/>
    <dynamicField name="*_ds" stored="true" type="pdate" multiValued="false" indexed="true"/>
    <dynamicField name="*_dms" stored="true" type="pdate" multiValued="true" indexed="true"/>
    <dynamicField name="*_dt" stored="false" type="pdate" multiValued="false" indexed="true"/>
    <dynamicField name="*_dtm" stored="false" type="pdate" multiValued="true" indexed="true"/>
    <dynamicField name="*_dts" stored="true" type="pdate" multiValued="false" indexed="true"/>
    <dynamicField name="*_dtms" stored="true" type="pdate" multiValued="true" indexed="true"/>
    <dynamicField name="*_e" stored="false" type="pdouble" multiValued="false" indexed="true"/>
    <dynamicField name="*_em" stored="false" type="pdouble" multiValued="true" indexed="true"/>
    <dynamicField name="*_es" stored="true" type="pdouble" multiValued="false" indexed="true"/>
    <dynamicField name="*_ems" stored="true" type="pdouble" multiValued="true" indexed="true"/>
    <dynamicField name="*_et" stored="false" termVectors="true" type="pdouble" multiValued="false" indexed="true"/>
    <dynamicField name="*_etm" stored="false" termVectors="true" type="pdouble" multiValued="true" indexed="true"/>
    <dynamicField name="*_ets" stored="true" termVectors="true" type="pdouble" multiValued="false" indexed="true"/>
    <dynamicField name="*_etms" stored="true" termVectors="true" type="pdouble" multiValued="true" indexed="true"/>
    <dynamicField name="*_f" stored="false" type="pfloat" multiValued="false" indexed="true"/>
    <dynamicField name="*_fm" stored="false" type="pfloat" multiValued="true" indexed="true"/>
    <dynamicField name="*_fs" stored="true" type="pfloat" multiValued="false" indexed="true"/>
    <dynamicField name="*_fms" stored="true" type="pfloat" multiValued="true" indexed="true"/>
    <dynamicField name="*_ft" stored="false" type="pfloat" multiValued="false" indexed="true"/>
    <dynamicField name="*_ftm" stored="false" type="pfloat" multiValued="true" indexed="true"/>
    <dynamicField name="*_fts" stored="true" type="pfloat" multiValued="false" indexed="true"/>
    <dynamicField name="*_ftms" stored="true" type="pfloat" multiValued="true" indexed="true"/>
    <dynamicField name="*_i" stored="false" type="pint" multiValued="false" indexed="true"/>
    <dynamicField name="*_im" stored="false" type="pint" multiValued="true" indexed="true"/>
    <dynamicField name="*_is" stored="true" type="pint" multiValued="false" indexed="true"/>
    <dynamicField name="*_ims" stored="true" type="pint" multiValued="true" indexed="true"/>
    <dynamicField name="*_it" stored="false" type="pint" multiValued="false" indexed="true"/>
    <dynamicField name="*_itm" stored="false" type="pint" multiValued="true" indexed="true"/>
    <dynamicField name="*_its" stored="true" type="pint" multiValued="false" indexed="true"/>
    <dynamicField name="*_itms" stored="true" type="pint" multiValued="true" indexed="true"/>
    <dynamicField name="*_l" stored="false" type="plong" multiValued="false" indexed="true"/>
    <dynamicField name="*_lm" stored="false" type="plong" multiValued="true" indexed="true"/>
    <dynamicField name="*_ls" stored="true" type="plong" multiValued="false" indexed="true"/>
    <dynamicField name="*_lms" stored="true" type="plong" multiValued="true" indexed="true"/>
    <dynamicField name="*_s" stored="false" type="string" multiValued="false" indexed="true"/>
    <dynamicField name="*_sm" stored="false" type="string" multiValued="true" indexed="true"/>
    <dynamicField name="*_ss" stored="true" type="string" multiValued="false" indexed="true"/>
    <dynamicField name="*_sms" stored="true" type="string" multiValued="true" indexed="true"/>
    <dynamicField name="*_p" type="location" indexed="true" stored="true" multiValued="false"/>
    <dynamicField name="*_ll" stored="false" type="location" multiValued="false" indexed="true"/>
    <dynamicField name="*_llm" stored="false" type="location" multiValued="true" indexed="true"/>
    <dynamicField name="*_lls" stored="true" type="location" multiValued="false" indexed="true"/>
    <dynamicField name="*_llms" stored="true" type="location" multiValued="true" indexed="true"/>
  </fields>

  <uniqueKey>id</uniqueKey>

  <similarity class="solr.ClassicSimilarityFactory"/>

  <copyField source="*_text" dest="textSpell"/>
  <copyField source="*_s" dest="textSpell"/>
</schema>
